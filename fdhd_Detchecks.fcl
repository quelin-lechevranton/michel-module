#include "services_refactored_pdune.fcl"
#include "simulationservices_dune.fcl"
#include "standard_reco_dune10kt.fcl"

process_name: RunDetchecks

services: {
    TFileService: { fileName: "fdhd_Detchecks_out.root" }
    @table::services
    @table::dunefd_1x2x6_reco_services
}

source: {
    module_type: RootInput
    maxEvents: 1
}

physics: {
    analyzers: {
        checks: {
            module_type:    "Detchecks"

            WireGeo: true
            WireEnds: false
            TPCBounds: true
            TPCChannels: false
            PlaneAxis: true
            ChannelPitch: false
            CollectionZ: false
            ViewUCoord: false
            ViewVCoord: false
        }
    }
    ana: [ checks ]
    end_paths: [ ana ]
}